{
  "name": "@donotdev/expo",
  "version": "0.3.2",
  "type": "module",
  "private": false,
  "description": "React Native/Expo UI components for DoNotDev framework",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./features": {
      "types": "./src/features/index.ts",
      "import": "./src/features/index.ts",
      "default": "./src/features/index.ts"
    }
  },
  "files": [
    "src",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/donotdev/expo.git"
  },
  "keywords": [
    "donotdev",
    "dndev",
    "react-native",
    "expo",
    "components",
    "ui",
    "typescript",
    "design-system"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit && bunx tsc --noEmit -p consumer-check"
  },
  "dependencies": {
    "@donotdev/core": "workspace:*",
    "@donotdev/crud": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "expo": "^55.0.32",
    "expo-audio": "~55.0.18",
    "expo-clipboard": "^55.0.17",
    "expo-document-picker": "^55.0.17",
    "expo-router": "^55.0.18",
    "expo-video": "~55.0.21",
    "react-native-safe-area-context": "^5.11.1"
  },
  "peerDependencies": {
    "@donotdev/auth": "^0.3.2",
    "@donotdev/billing": "^0.3.2",
    "@donotdev/oauth": "^0.3.2",
    "@donotdev/ui": "^0.3.3",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.0.0",
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-native": "^0.84.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@donotdev/auth": "workspace:*",
    "@donotdev/billing": "workspace:*",
    "@donotdev/oauth": "workspace:*",
    "@donotdev/ui": "workspace:*",
    "@hookform/resolvers": "^5.9.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-native": "^0.84.1",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "@donotdev/auth": {
      "optional": true
    },
    "@donotdev/billing": {
      "optional": true
    },
    "@donotdev/oauth": {
      "optional": true
    },
    "@donotdev/ui": {
      "optional": true
    },
    "firebase": {
      "optional": true
    }
  }
}
